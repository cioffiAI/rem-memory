{
  "name": "rem-memory",
  "version": "2.0.0-alpha.0",
  "description": "Local-first persistent memory for coding agents (OpenCode plugin) using a WRITE → DREAM → SURFACE lifecycle.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "commands",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun build ./src/index.ts --outfile ./dist/index.js --target node --format esm --external \"@opencode/plugin\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "bench": "bun run bench/run.ts",
    "verify:package": "bun run scripts/verify-package.ts",
    "check": "bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run check && bun run verify:package",
    "verify:runtime": "bun run scripts/verify-runtime.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "persistent-memory",
    "local-first",
    "coding-agent",
    "long-term-memory"
  ],
  "author": "Antonio Cioffi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cioffiAI/rem-memory.git"
  },
  "bugs": {
    "url": "https://github.com/cioffiAI/rem-memory/issues"
  },
  "homepage": "https://github.com/cioffiAI/rem-memory#readme",
  "dependencies": {
    "@opencode/plugin": "^2.0.18"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
